# Copy to .env.local (never commit real values). Every VITE_ variable is inlined into the public
# JavaScript bundle, so nothing here is a secret.

# "pilot" = login gate + all features, "public_mvp" (default) = open + fewer features
VITE_APP_VARIANT=public_mvp

# Only used by the "pilot" variant. A gate, not real authentication.
VITE_APP_PASSWORD=
